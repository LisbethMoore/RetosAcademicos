# MongoDB Atlas (en la nube): cambiar <usuario> y <contraseña> por los del Database User de Atlas
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@cluster0.iv54xhv.mongodb.net/retosdb?appName=Cluster0

# MongoDB local (alternativa sin internet)
# MONGODB_URI=mongodb://127.0.0.1:27017/retosdb

PORT=3000

# Clave secreta para firmar los tokens de sesión (JWT). Poner una cadena larga y aleatoria, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# Dirección del frontend: es el único origen que CORS deja consumir la API
FRONTEND_URL=http://localhost:5173
